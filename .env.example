# ── Supabase (required) ──────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Stripe (required for card payments) ──────────────────────────────
# Publishable key (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Push Notifications ───────────────────────────────────────────────
# VAPID public key for web push notifications
VITE_VAPID_PUBLIC_KEY=

# ── M-Pesa Daraja API ────────────────────────────────────────────────
# These are only needed if calling Daraja directly from the frontend.
# In production, M-Pesa credentials live on the Edge Function (server-side only).
VITE_MPESA_CONSUMER_KEY=
VITE_MPESA_CONSUMER_SECRET=
VITE_MPESA_PASSKEY=
VITE_MPESA_SHORTCODE=247247
VITE_MPESA_ENV=sandbox

# ── App URL ──────────────────────────────────────────────────────────
# Used for redirects and M-Pesa callbacks
VITE_APP_URL=https://chama-os.vercel.app
PUBLIC_SITE_URL=https://chama-os.vercel.app

# ── Edge Function Secrets (set via `supabase secrets set`) ───────────
# Do NOT put these in .env.local or .env.production. They are only
# available inside Supabase Edge Functions via Deno.env.get().
#
# Required:
#   VITE_STRIPE_SECRET_KEY       — Stripe secret key (sk_test_ or sk_live_)
#   STRIPE_WEBHOOK_SECRET        — Stripe webhook signing secret (whsec_)
#   SUPABASE_URL                 — Same as VITE_SUPABASE_URL above
#   SUPABASE_SERVICE_ROLE_KEY    — Service role key (secret! never expose to client)
#   RESEND_API_KEY               — Resend API key for transactional emails
#   PUBLIC_SITE_URL              — Same as above
#
# M-Pesa (optional):
#   MPESA_CONSUMER_KEY
#   MPESA_CONSUMER_SECRET
#   MPESA_PASSKEY
#   MPESA_SHORTCODE
#   MPESA_ENV
